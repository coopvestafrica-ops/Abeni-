rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── helper functions ──────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'staff'];
    }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own profile.
      // Admin/staff can read any profile (customer list, staff screen).
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());

      // Users can create/update their own profile.
      // Admin/staff can update any profile (e.g. change role).
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── orders ────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customers see only their own orders; admin/staff see all.
      allow read: if isAuthed() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Only the owning customer can create an order.
      allow create: if isAuthed() &&
        request.resource.data.userId == request.auth.uid;

      // Only admin/staff can change status, add notes, etc.
      allow update, delete: if isAdmin();

      // Internal notes sub-collection (admin-only).
      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // ── products ──────────────────────────────────────────────────────
    match /products/{productId} {
      // Anyone can browse products (no auth needed).
      allow read: if true;

      // Only admin/staff can create, edit or delete products.
      allow write: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      // Any authenticated user can read broadcasts.
      allow read: if isAuthed();

      // Only admin/staff can send broadcasts.
      allow write: if isAdmin();
    }

    // ── customer_messages ─────────────────────────────────────────────
    match /customer_messages/{msgId} {
      // Customers can read their own messages.
      allow read: if isAuthed() &&
        resource.data.userId == request.auth.uid;

      // Admin/staff can read all messages and create new ones.
      allow read, write: if isAdmin();
    }
  }
}
