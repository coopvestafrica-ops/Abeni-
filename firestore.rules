rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── helper functions ──────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // Uses Firebase Auth Custom Claims (set by the onUserRoleChanged Cloud
    // Function) so no extra Firestore read is needed on every request.
    // Fall back to checking the Firestore role field only when the claim
    // hasn't been set yet (e.g. legacy accounts before the function deployed).
    function isAdmin() {
      return isAuthed() && (
        request.auth.token.get('role', '') in ['admin', 'staff']
      );
    }

    // ── store_config ──────────────────────────────────────────────────
    // Delivery fee and other store-wide settings. Readable by anyone;
    // writable only by admin/staff.
    match /store_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();

      // FCM token sub-collection — only the owning user or admins.
      match /fcm_tokens/{token} {
        allow read, write: if isAuthed() &&
          (request.auth.uid == uid || isAdmin());
      }
    }

    // ── orders ────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthed() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthed() &&
        request.resource.data.userId == request.auth.uid;

      // Customers may only cancel their own pending orders.
      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        // Prevent altering any other field during a customer cancel.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
      );

      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // ── products ──────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── customer_messages ─────────────────────────────────────────────
    match /customer_messages/{msgId} {
      allow read: if isAuthed() &&
        resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
  }
}
