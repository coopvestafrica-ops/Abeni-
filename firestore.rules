rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── helper functions ──────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // Check admin/staff via Auth Custom Claims first (fast — no extra
    // Firestore read).  Fall back to the users document so the app works
    // immediately, even before the onUserRoleChanged Cloud Function has
    // been deployed and users have re-signed-in to refresh their token.
    function isAdmin() {
      return isAuthed() && (
        request.auth.token.get('role', '') in ['admin', 'staff']
        ||
        get(/databases/$(db)/documents/users/$(request.auth.uid))
          .data.get('role', '') in ['admin', 'staff']
      );
    }

    // ── store_config ──────────────────────────────────────────────────
    match /store_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();

      match /fcm_tokens/{token} {
        allow read, write: if isAuthed() &&
          (request.auth.uid == uid || isAdmin());
      }
    }

    // ── orders ────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuthed() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthed() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
      );

      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // ── products ──────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── customer_messages ─────────────────────────────────────────────
    match /customer_messages/{msgId} {
      allow read: if isAuthed() &&
        resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
  }
}
